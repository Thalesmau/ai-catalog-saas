# API
NODE_ENV=development
PORT=3333
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=ai_catalog

# Auth (gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change-me-to-a-random-string-with-at-least-32-chars
JWT_EXPIRES_IN=1d

# LLM
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Frontend
VITE_API_URL=http://localhost:3333
