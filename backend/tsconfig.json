{
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "target": "es2022",
    "lib": ["es2022"],
    "module": "commonjs",
    "types": ["node"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "paths": {
      "@application/*": ["./src/application/*"],
      "@infra/*": ["./src/infra/*"],
      "@kernel/*": ["./src/kernel/*"],
      "@main/*": ["./src/main/*"],
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": ["src", "scripts", "tests", "tsup.config.ts"]
}
